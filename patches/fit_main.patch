+  /* handle hello json CCC */
+  if (pMsg->ccc.idx == FIT_HELLO_JSON_CCC_IDX) {
+    if (pMsg->ccc.value == ATT_CLIENT_CFG_NOTIFY) {
+      HelloJsonCccState((dmConnId_t)pMsg->ccc.hdr.param, TRUE);
+    } else {
+      HelloJsonCccState((dmConnId_t)pMsg->ccc.hdr.param, FALSE);
+    }
+    return;
+  }
+
+  /* handle opus stream CCC */
+  if (pMsg->ccc.idx == FIT_OPUS_STREAM_CCC_IDX) {
+    if (pMsg->ccc.value == ATT_CLIENT_CFG_NOTIFY) {
+      OpusStreamCccState((dmConnId_t)pMsg->ccc.hdr.param, TRUE);
+      fitSendOpusChunk((dmConnId_t)pMsg->ccc.hdr.param);
+    } else {
+      OpusStreamCccState((dmConnId_t)pMsg->ccc.hdr.param, FALSE);
+      WsfTimerStop(&fitOpusTimer);
+    }
+    return;
+  }
 }
 
