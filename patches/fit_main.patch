+static void fitSendOpusChunk(dmConnId_t connId) {
+  bool_t hasMore;
+
+  hasMore = OpusStreamSendNextChunk();
+  if (hasMore) {
+    fitOpusTimer.msg.event = FIT_OPUS_TIMER_IND;
+    fitOpusTimer.msg.status = FIT_OPUS_STREAM_CCC_IDX;
+    fitOpusTimer.handlerId = fitHandlerId;
+    fitOpusTimer.msg.param = connId;
+    WsfTimerStartMs(&fitOpusTimer, FIT_OPUS_STREAM_PERIOD_MS);
+  } else {
+    WsfTimerStop(&fitOpusTimer);
+  }
+}
